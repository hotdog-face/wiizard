diff --git a/Source/Core/Core/IOS/Network/Socket.cpp b/Source/Core/Core/IOS/Network/Socket.cpp
index feb2579..84a3e9e 100644
--- a/Source/Core/Core/IOS/Network/Socket.cpp
+++ b/Source/Core/Core/IOS/Network/Socket.cpp
@@ -291,6 +291,23 @@ void WiiSocket::Update(bool read, bool write, bool except)
         memory.CopyFromEmu(&addr, ioctl.buffer_in + 8, sizeof(WiiSockAddrIn));
         sockaddr_in local_name = WiiSockMan::ToNativeAddrIn(addr);
 
+        // wii-sim patch: DOLPHIN_PORT_OFFSET shifts every port the guest binds (several simulators side by
+        // side on one host), DOLPHIN_BIND_ADDR pins the address, and SO_REUSEADDR lets a restarted simulator rebind at once.
+        static const int s_port_offset = [] {
+          const char* e = getenv("DOLPHIN_PORT_OFFSET");
+          return e ? atoi(e) : 0;
+        }();
+        if (s_port_offset != 0 && local_name.sin_port != 0)
+          local_name.sin_port = htons(static_cast<u16>(ntohs(local_name.sin_port) + s_port_offset));
+        // DOLPHIN_BIND_ADDR=127.0.0.1 keeps the guest's servers (fixed-port binds) off the LAN.
+        static const char* s_bind_addr = getenv("DOLPHIN_BIND_ADDR");
+        if (s_bind_addr && *s_bind_addr && local_name.sin_port != 0)
+          inet_pton(AF_INET, s_bind_addr, &local_name.sin_addr);
+        {
+          int one = 1;
+          setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&one), sizeof(one));
+        }
+
         int ret = bind(fd, (sockaddr*)&local_name, sizeof(local_name));
         ReturnValue = m_socket_manager.GetNetErrorCode(ret, "SO_BIND", false);
 
