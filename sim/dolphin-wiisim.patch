+#include <chrono>
+#include <csignal>
 #include <cstdio>
+#include <cstdlib>
 #include <thread>
 
 #include "Core/Core.h"
+#include "Core/HW/ProcessorInterface.h"
 #include "Core/System.h"
 #include "DolphinNoGUI/Platform.h"
+#include "VideoCommon/PerformanceMetrics.h"
 
 namespace
 {
+// wii-sim patch: SIGUSR1 taps the console's RESET button (kill -USR1 <pid>); SIGINT/SIGTERM tap POWER (stock).
+volatile std::sig_atomic_t s_reset_requested = 0;
+void ResetSignalHandler(int)
+{
+  s_reset_requested = 1;
+}
+
 class PlatformHeadless final : public Platform
 {
 public:
@@ -26,10 +38,35 @@ void PlatformHeadless::SetTitle(const std::string& title)
 
 void PlatformHeadless::MainLoop()
 {
+  // wii-sim patch: DOLPHIN_PERF_LOG=<secs> prints "perf speed=..% max=..%" to stdout that often.
+  const char* perf_env = std::getenv("DOLPHIN_PERF_LOG");
+  const int perf_secs = perf_env ? std::atoi(perf_env) : 0;
+  auto next_perf = std::chrono::steady_clock::now() + std::chrono::seconds(perf_secs);
+  std::signal(SIGUSR1, ResetSignalHandler);
   while (m_running.IsSet())
   {
     UpdateRunningFlag();
-    Core::HostDispatchJobs(Core::System::GetInstance());
+    auto& system = Core::System::GetInstance();
+    if (s_reset_requested)
+    {
+      s_reset_requested = 0;
+      std::fprintf(stdout, "wii-sim: RESET button tap\n");
+      std::fflush(stdout);
+      system.GetProcessorInterface().ResetButton_Tap();
+    }
+    Core::HostDispatchJobs(system);
+    if (perf_secs > 0 && std::chrono::steady_clock::now() >= next_perf)
+    {
+      next_perf += std::chrono::seconds(perf_secs);
+      if (Core::IsRunning(system))
+      {
+        auto& pm = system.GetPerfMetrics();
+        // speed = emulated time / wall time (100% = a real Wii); max = how fast it could run unthrottled
+        std::fprintf(stdout, "perf speed=%.0f%% max=%.0f%%\n", pm.GetSpeed() * 100.0,
+                     pm.GetMaxSpeed() * 100.0);
+        std::fflush(stdout);
+      }
+    }
     std::this_thread::sleep_for(std::chrono::milliseconds(100));
   }
 }
