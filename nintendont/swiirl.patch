+/* SWIIRL: while a game loads straight from the cabinet launcher (argsboot), the loader shows no text, which
+ * read as a broken black screen for ~10 s. Instead: the dark SWIIRL background fading in, and a calm ring of soft
+ * dots turning and breathing below the centre. One call = one frame (GRRLIB_Render waits for the vsync). */
+static int swiirl_frame;
+/* The loader blocks for seconds at a time (kernel load, IOS reload, storage mount), so the animation runs on its own
+ * thread: one frame per vsync whatever the main thread is doing. Main-thread calls become no-ops while it runs. */
+static lwp_t swiirl_thread = LWP_THREAD_NULL;
+static volatile int swiirl_run;
+static void swiirl_draw(void);
+static void *swiirl_loop(void *arg) { while (swiirl_run) swiirl_draw(); return NULL; }
+void SwiirlLoadingStart(void) {
+	if (swiirl_thread != LWP_THREAD_NULL) return;
+	swiirl_run = 1;
+	if (LWP_CreateThread(&swiirl_thread, swiirl_loop, NULL, NULL, 32 * 1024, 70) < 0) swiirl_thread = LWP_THREAD_NULL;
+}
+void SwiirlLoadingStop(void) {
+	if (swiirl_thread == LWP_THREAD_NULL) return;
+	swiirl_run = 0;
+	LWP_JoinThread(swiirl_thread, NULL);
+	swiirl_thread = LWP_THREAD_NULL;
+}
+void SwiirlLoadingFrame(void) { if (swiirl_thread == LWP_THREAD_NULL) swiirl_draw(); }
+static void swiirl_draw(void) {
+	int f = swiirl_frame++;
+	int fade = f < 24 ? f * 255 / 24 : 255;                  // the first ~0.4 s: in from black
+	GRRLIB_FillScreen(0x000000FF);
+	GRRLIB_DrawImg(bg_xPos, 0, background, 0, bg_xScale, 1, RGBA(255, 255, 255, fade));
+	const int dots = 12;
+	float spin = f * 0.045f;                                  // about one turn every 2.3 s
+	float breathe = 0.5f + 0.5f * sinf(f * 0.05f);            // slow swell of the whole ring
+	float cx = 320, cy = 340, r = 26 + 3 * breathe;
+	int i;
+	for (i = 0; i < dots; i++) {
+		float a = spin + i * (6.2831853f / dots);
+		int lead = (i * 255) / (dots - 1);                    // a soft comet: brightest dot leads, the rest trail off
+		int alpha = (40 + lead * 215 / 255) * fade / 255;
+		float size = 2.2f + 2.6f * lead / 255.0f;
+		GRRLIB_Circle(cx + r * cosf(a), cy + r * sinf(a), size + 2.5f, RGBA(80, 255, 130, alpha / 5), 1);   // glow
+		GRRLIB_Circle(cx + r * cosf(a), cy + r * sinf(a), size, RGBA(170, 255, 190, alpha), 1);
+	}
+	GRRLIB_Render();
+}
+void SwiirlLoadingFadeOut(void) {                         // to black before the game takes the screen
+	int i;
+	SwiirlLoadingStop();
+	for (i = 1; i <= 12; i++) {
+		swiirl_draw();
+		GRRLIB_FillScreen(RGBA(0, 0, 0, i * 255 / 12));
+		GRRLIB_Render();
+	}
+}
