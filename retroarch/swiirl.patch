+#if defined(GEKKO)
+/* SWIIRL: the 2019 Wii network library has no getsockname (only netplay NAT traversal uses it; not used here) */
+int getsockname(int s, struct sockaddr *addr, socklen_t *len) { (void)s; (void)addr; (void)len; return -1; }
+#endif
+#if defined(GEKKO)
+/* SWIIRL: on the Wii, bringing the network up (if_config) can take seconds, or long on bad Wi-Fi. Do it on a
+ * thread so the game starts at once; the command interface answers as soon as the socket is bound (poll skips a
+ * socket that is not there yet). netcmd is never freed on the Wii (the thread may still hold it). */
+static void command_network_bringup(void *data)
+{
+   command_network_t *netcmd = (command_network_t*)data;
+   struct addrinfo *res = NULL;
+   int fd;
+   if (!network_init())
+      return;
+   fd = socket_init((void**)&res, netcmd->port, NULL, SOCKET_TYPE_DATAGRAM, AF_INET);
+   if (fd < 0)
+      return;
+   if (!socket_nonblock(fd) || !socket_bind(fd, (void*)res))
+   {
+      socket_close(fd);
+      fd = -1;
+   }
+   if (res)
+      freeaddrinfo_retro(res);
+   netcmd->net_fd = fd;
+   RARCH_LOG("[NetCMD] Command interface up on port %hu (fd %d).\n", (unsigned short)netcmd->port, fd);
+}
+
+command_t* command_network_new(uint16_t port)
+{
+   command_t            *cmd = (command_t*)calloc(1, sizeof(*cmd));
+   command_network_t *netcmd = (command_network_t*)calloc(1, sizeof(command_network_t));
+   if (!cmd || !netcmd)
+   {
+      free(cmd);
+      free(netcmd);
+      return NULL;
+   }
+   netcmd->net_fd = -1;
+   netcmd->port   = port;
+   cmd->userptr   = netcmd;
+   cmd->poll      = command_network_poll;
+   cmd->replier   = network_command_reply;
+   cmd->destroy   = network_command_free;
+   sthread_create(command_network_bringup, netcmd);
+   return cmd;
+}
+#else
 command_t* command_network_new(uint16_t port)
 {
    struct addrinfo     *res  = NULL;
@@ -275,6 +328,7 @@ error:
    free(cmd);
    return NULL;
 }
+#endif /* GEKKO */
 #endif
 
