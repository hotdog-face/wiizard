diff --git a/runloop.c b/runloop.c
index 679517b..b1fdd96 100644
--- a/runloop.c
+++ b/runloop.c
@@ -5568,6 +5568,61 @@ static INLINE bool runloop_is_libretro_running(runloop_state_t* runloop_st, bool
       &&    runloop_st->flags & RUNLOOP_FLAG_CORE_RUNNING);
 }
 
+#if defined(GEKKO)
+/* SWIIRL autotest: if sd:/arcade/autotest holds a positive integer N (seconds), quit N seconds after content
+ * starts running, through the quit-key path (RUNLOOP_STATE_QUIT -> CMD_EVENT_QUIT, as a player's quit or the
+ * network QUIT does). Missing or invalid file: no effect. The file is only read, never changed (the launcher
+ * owns it). */
+#define SWIIRL_AUTOTEST_PATH "sd:/arcade/autotest"
+static long         swiirl_autotest_secs     = -1; /* -1: not read yet, 0: off or done */
+static retro_time_t swiirl_autotest_deadline = 0;
+
+static void swiirl_autotest_read(void)
+{
+   char buf[24];
+   char *end = NULL;
+   size_t len;
+   long n;
+   FILE *f   = fopen(SWIIRL_AUTOTEST_PATH, "r");
+
+   swiirl_autotest_secs = 0;
+   if (!f)
+      return;
+   len      = fread(buf, 1, sizeof(buf) - 1, f);
+   fclose(f);
+   buf[len] = '\0';
+   n        = strtol(buf, &end, 10);
+   while (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n')
+      end++;
+   if (end != buf && *end == '\0' && n > 0 && n <= 1000000)
+      swiirl_autotest_secs = n;
+}
+
+/* On every frame the core runs: starts the clock on the first one with content loaded. */
+static void swiirl_autotest_arm(runloop_state_t *runloop_st, retro_time_t now)
+{
+   if (     swiirl_autotest_secs > 0
+         && !swiirl_autotest_deadline
+         && runloop_st->current_core_type != CORE_TYPE_DUMMY
+         && !path_is_empty(RARCH_PATH_CONTENT))
+      swiirl_autotest_deadline = now + (retro_time_t)swiirl_autotest_secs * 1000000;
+}
+
+static bool swiirl_autotest_due(retro_time_t now)
+{
+   if (swiirl_autotest_secs < 0)
+      swiirl_autotest_read();   /* first frame after start-up */
+   if (     swiirl_autotest_secs <= 0
+         || !swiirl_autotest_deadline
+         || now < swiirl_autotest_deadline)
+      return false;
+   RARCH_LOG("[SWIIRL] autotest: %ld s of content elapsed (%s), quitting.\n",
+         swiirl_autotest_secs, SWIIRL_AUTOTEST_PATH);
+   swiirl_autotest_secs = 0;
+   return true;
+}
+#endif
+
 static enum runloop_state_enum runloop_check_state(
       input_driver_state_t *input_st,
       audio_driver_state_t *audio_st,
@@ -5918,6 +5973,11 @@ static enum runloop_state_enum runloop_check_state(
