 #include "../../tasks/tasks_internal.h"
 
 #ifdef GEKKO
@@ -136,10 +138,53 @@ static bool g_menu = false;
 #ifdef HW_RVL
 static bool g_quit = false;
 
-static void power_callback(void) { g_quit = true; }
-#endif
+/* WIIZARD (frontend/drivers/wiizard_wii.c): POWER = clean unload then power off, RESET = quit to WIIZARD when
+ * started by it (instead of RetroArch's menu), any input change resets the idle-quit timer */
+extern bool wiizard_active(void);
+extern void wiizard_request_quit(void);
+extern void wiizard_request_poweroff(void);
+extern void wiizard_input_activity(void);
+
+static void power_callback(void) { wiizard_request_poweroff(); g_quit = true; }
+
+static void reset_cb(unsigned int a, void *b)
+{
+   if (wiizard_active())
+      wiizard_request_quit();
+   else
+      g_menu = true;
+}
 
+/* idle-quit activity: any digital change, or an analog axis moving more than WZ_ANALOG_STEP from where it was at
+ * the last activity (stick noise doesn't count), on any port */
+#define WZ_ANALOG_STEP 0x1000
+static void wiizard_check_activity(void)
+{
+   static uint64_t ref_state[DEFAULT_MAX_PADS];
+   static int16_t  ref_analog[DEFAULT_MAX_PADS][2][2];
+   bool changed = false;
+   unsigned p, i, j;
+   for (p = 0; p < DEFAULT_MAX_PADS; p++)
+   {
+      if (pad_state[p] != ref_state[p])
+         changed = true;
+      for (i = 0; i < 2; i++)
+         for (j = 0; j < 2; j++)
+         {
+            int d = (int)analog_state[p][i][j] - (int)ref_analog[p][i][j];
+            if (d > WZ_ANALOG_STEP || d < -WZ_ANALOG_STEP)
+               changed = true;
+         }
+   }
+   if (!changed)
+      return;
+   memcpy(ref_state, pad_state, sizeof(ref_state));
+   memcpy(ref_analog, analog_state, sizeof(ref_analog));
+   wiizard_input_activity();
+}
+#else
 static void reset_cb(unsigned int a, void *b) { g_menu = true; }
+#endif
 
 #ifdef HW_RVL
 static inline void gx_mouse_info(uint32_t joybutton, unsigned port)
@@ -454,6 +499,7 @@ static void gx_joypad_poll(void)
 #ifdef HW_RVL
    if (g_quit)
    {
+      RARCH_LOG("[WIIZARD] POWER pressed: unloading content (saves), then powering off.\n");
       retroarch_ctl(RARCH_CTL_SET_SHUTDOWN, NULL);
       g_quit = false;
       return;
@@ -592,6 +638,9 @@ static void gx_joypad_poll(void)
                analog_state[port][i][j] = -0x7fff;
    }
 
+#ifdef HW_RVL
+   wiizard_check_activity();
+#endif
    state_p1 = pad_state[0];
 
    BIT64_CLEAR(lifecycle_state, RARCH_MENU_TOGGLE);
