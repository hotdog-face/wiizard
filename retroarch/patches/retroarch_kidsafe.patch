diff --git a/frontend/drivers/wiizard_wii.c b/frontend/drivers/wiizard_wii.c
index 66655df..0ead940 100644
--- a/frontend/drivers/wiizard_wii.c
+++ b/frontend/drivers/wiizard_wii.c
@@ -466,3 +466,76 @@ static void wiizard_return_to_launcher(void)
    wiizard_exec_wii(WZ_LAUNCHER, args, len);   /* no return on success */
    wz_screen_free();
 }
+
+/* ---------------------------------------------------------------- kid-safe cabinet buttons + idle quit
+ * RESET (front of the Wii): quits to WIIZARD like L+R+Z+START, instead of opening RetroArch's menu
+ *   (gx_joypad.c reset_cb -> wiizard_request_quit; consumed by runloop.c through wiizard_quit_due).
+ * POWER: the normal clean unload (content, SRAM .srm, the cores' .hi/.nv on deinit), then the console powers off
+ *   instead of returning to WIIZARD (gx_joypad.c power_callback -> wiizard_request_poweroff; done at frontend
+ *   shutdown, after main_exit has unloaded everything).
+ * Idle quit (WIIZARD starts only): no button or analog stick change on any port for WZ_IDLE_MINUTES -> quit to
+ *   WIIZARD (which powers off by itself after its own attract-mode idle time). sd:/arcade/idletest present:
+ *   WZ_IDLE_TEST_MINUTES instead (read once, on the first frame; the file is never changed). Separate from the
+ *   autotest timer (runloop.c swiirl_autotest_*). */
+#define WZ_IDLE_MINUTES      15
+#define WZ_IDLE_TEST_MINUTES 1
+#define WZ_IDLE_TEST_PATH    "sd:/arcade/idletest"
+
+static volatile bool wz_quit_req;        /* RESET pressed */
+static volatile bool wz_poweroff_req;    /* POWER pressed */
+static volatile u32 wz_activity;         /* bumped by the pad driver on any input change */
+
+bool wiizard_active(void) { return wz.active; }
+void wiizard_request_quit(void) { wz_quit_req = true; }
+void wiizard_request_poweroff(void) { wz_poweroff_req = true; }
+void wiizard_input_activity(void) { wz_activity++; }
+
+/* runloop_check_state, every frame, next to the autotest: true = quit now (through the quit-key path) */
+bool wiizard_quit_due(int64_t now_us)
+{
+   static int     idle_secs = -1;        /* -1: not read yet */
+   static int64_t idle_since;
+   static u32     seen;
+   if (wz_quit_req)
+   {
+      wz_quit_req = false;
+      RARCH_LOG("[WIIZARD] RESET pressed: quitting to WIIZARD.\n");
+      return true;
+   }
+   if (!wz.active)
+      return false;
+   if (idle_secs < 0)
+   {
+      struct stat st;
+      bool test = stat(WZ_IDLE_TEST_PATH, &st) == 0;
+      idle_secs = (test ? WZ_IDLE_TEST_MINUTES : WZ_IDLE_MINUTES) * 60;
+      RARCH_LOG("[WIIZARD] idle quit after %d s without input%s.\n", idle_secs,
+            test ? " (" WZ_IDLE_TEST_PATH " present)" : "");
+   }
+   if (!idle_since || seen != wz_activity)
+   {
+      seen       = wz_activity;
+      idle_since = now_us;
+      return false;
+   }
+   if (now_us - idle_since < (int64_t)idle_secs * 1000000)
+      return false;
+   RARCH_LOG("[WIIZARD] idle: no controller input for %d s, quitting to WIIZARD.\n", idle_secs);
+   idle_since = 0;
+   return true;
+}
+
+/* frontend shutdown, before the return to the launcher: POWER was pressed -> the console goes off. Everything is
+ * unloaded and saved by now (main_exit); unmounting flushes the card's FAT caches first. */
+static void wiizard_poweroff_if_requested(void)
+{
+   if (!wz_poweroff_req)
+      return;
+   wiizard_loading_stop();
+   VIDEO_SetBlack(true);
+   VIDEO_Flush();
+   VIDEO_WaitVSync();
+   fatUnmount("sd:");
+   fatUnmount("usb:");
+   SYS_ResetSystem(SYS_POWEROFF, 0, 0);
+}
diff --git a/input/drivers_joypad/gx_joypad.c b/input/drivers_joypad/gx_joypad.c
index e9fc8cc..88eb43a 100644
--- a/input/drivers_joypad/gx_joypad.c
