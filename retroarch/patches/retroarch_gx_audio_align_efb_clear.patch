diff --git a/audio/drivers/gx_audio.c b/audio/drivers/gx_audio.c
index bd864c5..014a3e9 100644
--- a/audio/drivers/gx_audio.c
+++ b/audio/drivers/gx_audio.c
@@ -39,7 +39,9 @@
 typedef struct
 {
    size_t write_ptr;
-   uint32_t data[BLOCKS][CHUNK_FRAMES];
+   /* 32-byte aligned: the AI DMA address drops its low 5 bits, so an unaligned chunk made the DMA start 4 bytes
+    * early and play the previous chunk last frame (zeroed by the callback memset) = one bad sample per chunk */
+   uint32_t data[BLOCKS][CHUNK_FRAMES] __attribute__((aligned(32)));
    volatile unsigned dma_busy;
    volatile unsigned dma_next;
    volatile unsigned dma_write;
diff --git a/gfx/drivers/gx_gfx.c b/gfx/drivers/gx_gfx.c
