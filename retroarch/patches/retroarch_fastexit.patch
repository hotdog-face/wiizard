diff --git a/frontend/drivers/platform_wii.c b/frontend/drivers/platform_wii.c
index fa495fe..f5c6791 100644
--- a/frontend/drivers/platform_wii.c
+++ b/frontend/drivers/platform_wii.c
@@ -164,6 +164,124 @@ static void dol_copy_raw_argv(const char *dolpath,
    DCFlushRange(argv, sizeof(*argv) + argv->length);
 }
 
+#ifndef IS_SALAMANDER
+/* WIIZARD: AHBPROT (the hardware access Nintendont and USB Loader GX need) survives an IOS reload only if ES is
+ * patched first. Same code as the launcher (agent/source/main.c keep_ahbprot), done as Priiloader does it
+ * (src/Shared/IOS.cpp): 16-bit access to the MEM2 protection register 0x0d8b420a (0 = off), search the IOS MEM2 from
+ * the pointer at 0x80003130 for the ES "TMD access rights" check, make it load 0xFF, protection back on.
+ * Returns 1 patched, 0 no AHBPROT (or pattern not found), < 0 error. */
+#define WZ_HAVE_AHBPROT (*(vu32 *)0xCD800064 == 0xFFFFFFFF)
+static inline u16 wz_reg16(u32 a) { return *(vu16 *)(0xC0000000 | a); }
+static inline void wz_reg16_set(u32 a, u16 v) { *(vu16 *)(0xC0000000 | a) = v; __asm__ volatile("eieio"); }
+static int wiizard_keep_ahbprot(void)
+{
+   static const u8 pattern[] = { 0x68, 0x5B, 0x22, 0xEC, 0x00, 0x52, 0x18, 0x9B, 0x68, 0x1B, 0x46, 0x98, 0x07, 0xDB };
+   u8 *p;
+   u32 len;
+   int found = 0;
+   if (!WZ_HAVE_AHBPROT)
+      return 0;
+   if (wz_reg16(0x0d8b420a))
+      wz_reg16_set(0x0d8b420a, 0);
+   if (wz_reg16(0x0d8b420a))
+      return -2;
+   p = (u8 *)*(vu32 *)0xC0003130;          /* the u32 at 0x80003130, read uncached */
+   if ((u32)p < 0x90000000 || (u32)p >= 0x93FFFFFF)
+   {
+      wz_reg16_set(0x0d8b420a, 1);
+      return -3;
+   }
+   len = 0x93FFFFFF - (u32)p;
+   DCFlushRange(p, len);
+   ICInvalidateRange(p, len);
+   for (; (u32)p < 0x93FFFFFF - sizeof(pattern); p++)
+   {
+      u8 *line;
+      if (p[0] != 0x68 || memcmp(p, pattern, sizeof(pattern)))
+         continue;
+      p[8] = 0x23; p[9] = 0xFF;              /* ldr r3,[r3] -> movs r3,#0xFF: the TMD "has" every access right */
+      line = (u8 *)((u32)p & ~31);
+      DCFlushRange(line, 64);
+      ICInvalidateRange(line, 64);
+      found = 1;
+      break;
+   }
+   wz_reg16_set(0x0d8b420a, 1);
+   return found;
+}
+
+/* WIIZARD: start a DOL with raw arguments (NUL-separated strings + a final NUL) on a freshly reloaded IOS that keeps
+ * AHBPROT, as the launcher's own exec does. Returns only if the DOL can't be read. */
+void wiizard_exec_wii(const char *_path, const char *_args, size_t args_len)
+{
+   FILE *fp;
+   void *dol;
+   size_t _len;
+   char path[PATH_MAX_LENGTH];
+   char args[256];
+
+   if (args_len > sizeof(args))
+      return;
+   strlcpy(path, _path, sizeof(path));
+   memcpy(args, _args, args_len);
+   if (!(fp = fopen(path, "rb")))
+      return;
+   fseek(fp, 0, SEEK_END);
+   _len = ftell(fp);
+   fseek(fp, 0, SEEK_SET);
+   if (!_len || !(dol = malloc(_len)))
+   {
+      fclose(fp);
+      return;
+   }
+   if (fread(dol, 1, _len, fp) != _len)
+   {
+      fclose(fp);
+      free(dol);
+      return;
+   }
+   fclose(fp);
+
+   wiizard_keep_ahbprot();                  /* ES patched while IOS still serves the card (as the launcher does) */
+
+   fatUnmount("carda:");
+   fatUnmount("cardb:");
+   fatUnmount("sd:");
+   fatUnmount("usb:");
+   __io_wiisd.shutdown();
+   __io_usbstorage.shutdown();
+
+   VIDEO_SetBlack(true);                    /* the copy below lands in MEM1, where our framebuffer is */
+   VIDEO_Flush();
+   VIDEO_WaitVSync();
+
+   /* from here on no heap: the DOL goes over MEM2 */
+   memmove(EXECUTE_ADDR, dol, _len);
+   DCFlushRange(EXECUTE_ADDR, _len);
+   {
+      /* argv for the booter (it copies the struct to the entry point + 8): path, then the raw arguments. (Not
+       * dol_copy_raw_argv: it writes the struct after ARGS_ADDR, where the booter never finds it.) */
+      struct __argv *argv = (struct __argv *)ARGS_ADDR;
+      char *cmdline       = (char *)ARGS_ADDR + sizeof(struct __argv);
+      size_t plen         = strlen(path) + 1;
+      memset(argv, 0, sizeof(*argv));
+      memcpy(cmdline, path, plen);
+      memcpy(cmdline + plen, args, args_len);
+      argv->argvMagic   = ARGV_MAGIC;
+      argv->commandLine = cmdline;
+      argv->length      = (int)(plen + args_len);
+      DCFlushRange(ARGS_ADDR, sizeof(*argv) + argv->length);
+   }
+   _len = booter_end - booter_start;
+   memcpy(BOOTER_ADDR, booter_start, _len);
+   DCFlushRange(BOOTER_ADDR, _len);
+
+   IOS_ReloadIOS(IOS_GetVersion());         /* fresh IOS for the launcher (network, USB); AHBPROT kept by the patch */
+   SYS_ResetSystem(SYS_SHUTDOWN, 0, 0);
+   __lwp_thread_stopmultitasking((void (*)(void))BOOTER_ADDR);
+}
+#endif
+
 /* WARNING: after we move any data
  * into EXECUTE_ADDR, we can no longer use any
  * heap memory and are restricted to the stack only. */
