+/* WIIZARD (the garage-arcade launcher, sd:/apps/wii-agent/boot.dol) integration for RetroArch on the Wii.
+ * Included by frontend/drivers/platform_gx.c (HW_RVL, not salamander).
+ *
+ * The launcher starts a core DOL with argv = <ROM folder> <ROM file> --wiizard-title=<title>
+ * --wiizard-screen=<width %>,<height %>,<x>,<y> [--autobooted]. RetroArch itself reads only argv[1..2]; the extra
+ * arguments mark a WIIZARD start and:
+ *  - a terminal-style loading screen ("> LOADING <TITLE>", a bar that follows the reads of the content file) is drawn
+ *    straight into a framebuffer of its own from frontend init until the video driver starts (content, e.g. a big
+ *    Neo Geo zip, is loaded before video init, so the GX driver can't draw it), animated by a small LWP thread;
+ *  - IOS is not reloaded at start (the launcher reloaded it just before jumping here; a second reload costs time and
+ *    would drop AHBPROT);
+ *  - quitting execs the launcher directly (boot.dol --relaunch=game) instead of exit() through the HBC reload stub,
+ *    which the launcher points at the System Menu (System Menu -> Priiloader -> NAND hop -> launcher: seconds of
+ *    black). AHBPROT is kept across that IOS reload with Priiloader's ES patch, as the launcher does it.
+ * Colours and layout match the launcher's "RETURNING TO WIIZARD" screen (ui.c ui_wait_frame), including its CRT
+ * calibration (scaled about the screen centre, then shifted). */
+
+#include <ctype.h>
+#include <malloc.h>
+#include <sys/stat.h>
+#include <sys/iosupport.h>
+#include <ogc/lwp.h>
+#include <ogc/video.h>
+#include <ogc/system.h>
+#include <ogc/cache.h>
+#include <ogc/lwp_watchdog.h>
+#include "wiizard_font.h"
+
+#define WZ_LAUNCHER "sd:/apps/wii-agent/boot.dol"
+#define WZ_BG    0x030A06
+#define WZ_GREEN 0x50FF82
+#define WZ_DIM   0x3FCC6A
+#define WZ_LY0   180                    /* logical rows drawn (640x480 space): the two text lines and their glow */
+#define WZ_ROWS  64
+#define WZ_LINE1 190
+#define WZ_LINE2 218
+#define WZ_X     60
+#define WZ_BAR   28
+
+extern void wiizard_exec_wii(const char *path, const char *args, size_t len);
+
+static struct
+{
+   bool active;                          /* started by WIIZARD */
+   bool autobooted;
+   char title[64];
+   int sx, sy, ox, oy;                   /* CRT calibration: width %, height %, x, y */
+} wz = { false, false, "", 100, 100, 0, 0 };
+
+static bool wz_game_ran;                 /* the video driver started: content loaded (told to the launcher) */
+static GXRModeObj *wz_mode;
+static void *wz_xfb_mem;                 /* cached pointer as allocated */
+static u32 *wz_xfb;                      /* uncached view */
+static u8 *wz_txt, *wz_glw, *wz_tmp, *wz_rgb;
+static lwp_t wz_thread = LWP_THREAD_NULL;
+static volatile int wz_run;
+static u8 *wz_stack;
+static u64 wz_t0;
+static int wz_last_key = -1;
+static int wz_p_shown;                   /* progress in 1/1000, never goes back */
+static char wz_line1[96];
+
+/* progress: bytes read from the content file (any open handle whose size equals the content's), via the SD
+ * devoptab's read_r. Only read_r is wrapped (open_r stays libfat's, so fatUnmount still accepts the device). */
+static volatile u32 wz_read_bytes;
+static u32 wz_content_size;
+static int wz_sd_index = -1;
+static const devoptab_t *wz_sd_orig;
+static devoptab_t *wz_sd_wrap;           /* heap: fatUnmount frees whatever devoptab is registered */
+
+static ssize_t wz_read_r(struct _reent *r, void *fd, char *ptr, size_t len)
+{
+   ssize_t n = wz_sd_orig->read_r(r, fd, ptr, len);
+   if (n > 0 && fd && wz_content_size && *(const uint32_t *)fd == wz_content_size)   /* libfat FILE_STRUCT.filesize */
+      wz_read_bytes += (u32)n;
+   return n;
+}
+
+static void wiizard_track_content(void)
+{
+   struct stat st;
+   char path[PATH_MAX_LENGTH];
+   if (!wz.active || !__system_argv || __system_argv->argc < 3)
+      return;
+   fill_pathname_join(path, __system_argv->argv[1], __system_argv->argv[2], sizeof(path));
+   if (stat(path, &st) != 0 || st.st_size <= 0)
+      return;
+   wz_content_size = (u32)st.st_size;
+   wz_sd_index     = FindDevice("sd:");
+   if (wz_sd_index < 0 || !devoptab_list[wz_sd_index] || !devoptab_list[wz_sd_index]->read_r)
+      return;
+   wz_sd_orig = devoptab_list[wz_sd_index];
+   wz_sd_wrap = (devoptab_t*)malloc(sizeof(*wz_sd_wrap));
+   if (!wz_sd_wrap)
+      return;
+   *wz_sd_wrap        = *wz_sd_orig;
+   wz_sd_wrap->read_r = wz_read_r;
+   devoptab_list[wz_sd_index] = wz_sd_wrap;
+}
+
+static void wiizard_untrack_content(void)
+{
+   if (wz_sd_wrap && wz_sd_index >= 0 && devoptab_list[wz_sd_index] == wz_sd_wrap)
+   {
+      devoptab_list[wz_sd_index] = wz_sd_orig;
+      free(wz_sd_wrap);
+   }
+   wz_sd_wrap = NULL;
+}
+
+/* argv[3..]: --wiizard-title=..., --wiizard-screen=sx,sy,x,y, --autobooted */
+static void wiizard_parse_args(void)
+{
+   int i;
+   if (!__system_argv || __system_argv->argvMagic != ARGV_MAGIC || __system_argv->argc < 4 || !__system_argv->argv)
+      return;
+   for (i = 3; i < __system_argv->argc; i++)
+   {
+      const char *a = __system_argv->argv[i];
+      if (!a)
+         continue;
+      if (!strncmp(a, "--wiizard-title=", 16))
+      {
+         size_t k, n = 0;
+         for (k = 16; a[k] && n < sizeof(wz.title) - 1; k++)
+            if ((unsigned char)a[k] >= 32 && (unsigned char)a[k] < 127)
+               wz.title[n++] = (char)toupper((unsigned char)a[k]);
+         wz.title[n] = '\0';
+         wz.active   = true;
+      }
+      else if (!strncmp(a, "--wiizard-screen=", 17))
+      {
+         int sx, sy, x, y;
+         if (sscanf(a + 17, "%d,%d,%d,%d", &sx, &sy, &x, &y) == 4 && sx >= 60 && sx <= 110 && sy >= 60 && sy <= 110
+               && x > -100 && x < 100 && y > -100 && y < 100)
+         {
+            wz.sx = sx; wz.sy = sy; wz.ox = x; wz.oy = y;
+         }
+      }
+      else if (!strcmp(a, "--autobooted"))
+         wz.autobooted = true;
+   }
+}
+
+/* ---------------------------------------------------------------- drawing (integer only: runs on a thread) */
+
+static u32 wz_yuv(int r1, int g1, int b1, int r2, int g2, int b2)
+{
+   int y1 = ((66 * r1 + 129 * g1 + 25 * b1 + 128) >> 8) + 16;
+   int y2 = ((66 * r2 + 129 * g2 + 25 * b2 + 128) >> 8) + 16;
+   int r  = (r1 + r2) >> 1, g = (g1 + g2) >> 1, b = (b1 + b2) >> 1;
+   int cb = ((-38 * r - 74 * g + 112 * b + 128) >> 8) + 128;
+   int cr = ((112 * r - 94 * g - 18 * b + 128) >> 8) + 128;
+   return ((u32)y1 << 24) | ((u32)cb << 16) | ((u32)y2 << 8) | (u32)cr;
+}
+
+static void wz_text(const char *s, int x, int y)
+{
+   for (; *s; s++, x += WZ_FONT_ADV)
+   {
+      int c = (unsigned char)*s, gy, gx;
+      if (c <= 32 || c >= 127)
+         continue;
+      for (gy = 0; gy < WZ_FONT_H; gy++)
+      {
+         int ly = y + gy - WZ_LY0;
+         if (ly < 0 || ly >= WZ_ROWS)
+            continue;
+         for (gx = 0; gx < WZ_FONT_CELL; gx++)
+         {
+            int lx = x - WZ_FONT_PAD + gx;
+            u8 a   = wz_font[c - 32][gy][gx];
+            if (a && lx >= 0 && lx < 640 && a > wz_txt[ly * 640 + lx])
+               wz_txt[ly * 640 + lx] = a;
+         }
+      }
+   }
+}
+
+/* the launcher's glow: the glyph alpha box-blurred (5 taps, edges averaged over what exists) h then v, twice */
+static void wz_blur(void)
+{
+   int pass, x, y, d;
+   memcpy(wz_glw, wz_txt, WZ_ROWS * 640);
+   for (pass = 0; pass < 2; pass++)
+   {
+      for (y = 0; y < WZ_ROWS; y++)
+         for (x = 0; x < 640; x++)
+         {
+            int sum = 0, n = 0;
+            for (d = -2; d <= 2; d++)
+               if (x + d >= 0 && x + d < 640) { sum += wz_glw[y * 640 + x + d]; n++; }
+            wz_tmp[y * 640 + x] = (u8)(sum / n);
+         }
+      for (y = 0; y < WZ_ROWS; y++)
+         for (x = 0; x < 640; x++)
+         {
+            int sum = 0, n = 0;
+            for (d = -2; d <= 2; d++)
+               if (y + d >= 0 && y + d < WZ_ROWS) { sum += wz_tmp[(y + d) * 640 + x]; n++; }
+            wz_glw[y * 640 + x] = (u8)(sum / n);
+         }
+   }
+}
+
+static void wz_fill_bg(void)
+{
+   u32 w = wz_yuv(3, 10, 6, 3, 10, 6), i, n = wz_mode->fbWidth / 2 * wz_mode->xfbHeight;
+   for (i = 0; i < n; i++)
+      wz_xfb[i] = w;
+}
+
+/* composes the text rows (logical) and maps them onto the framebuffer with the CRT calibration, bilinear */
+static void wz_present(int cursor_x, bool cursor_on)
+{
+   int ly, lx, Y, X;
+   const int fbw = wz_mode->fbWidth, fbh = wz_mode->xfbHeight;
+   wz_blur();
+   for (ly = 0; ly < WZ_ROWS; ly++)
+   {
+      int col = (WZ_LY0 + ly) < WZ_LINE2 - 5 ? WZ_GREEN : WZ_DIM;
+      int cr = col >> 16, cg = (col >> 8) & 255, cb = col & 255;
+      int on  = cursor_on && WZ_LY0 + ly >= WZ_LINE1 + 2 && WZ_LY0 + ly < WZ_LINE1 + 18;
+      for (lx = 0; lx < 640; lx++)
+      {
+         int i = ly * 640 + lx, g = wz_glw[i] * 120 / 255, a = wz_txt[i];
+         int r = 3 + cr * g / 255, gg = 10 + cg * g / 255, b = 6 + cb * g / 255;
+         u8 *o = wz_rgb + i * 3;
+         if (r > 255) r = 255;
+         if (gg > 255) gg = 255;
+         if (b > 255) b = 255;
+         r  += (cr - r) * a / 255;
+         gg += (cg - gg) * a / 255;
+         b  += (cb - b) * a / 255;
+         if (on && lx >= cursor_x && lx < cursor_x + 9)
+         {
+            r  += ((WZ_GREEN >> 16) - r) * 240 / 255;
+            gg += (((WZ_GREEN >> 8) & 255) - gg) * 240 / 255;
+            b  += ((WZ_GREEN & 255) - b) * 240 / 255;
+         }
+         o[0] = (u8)r; o[1] = (u8)gg; o[2] = (u8)b;
+      }
+   }
+   for (Y = 0; Y < fbh; Y++)
+   {
+      /* framebuffer row -> 640x480 screen row -> logical row (8.8 fixed point) */
+      int sy8 = Y * 480 * 256 / fbh;
+      int ly8 = ((sy8 - (240 + wz.oy) * 256) * 100) / wz.sy + 240 * 256 - WZ_LY0 * 256;
+      int y0, fy;
+      u32 *row;
+      if (ly8 < -256 || ly8 >= WZ_ROWS * 256)
+         continue;
+      y0  = ly8 >> 8;
+      fy  = ly8 & 255;
+      row = wz_xfb + Y * (fbw / 2);
+      for (X = 0; X < fbw; X += 2)
+      {
+         int px[2][3], k, c;
+         for (k = 0; k < 2; k++)
+         {
+            int sx8 = (X + k) * 640 * 256 / fbw;
+            int lx8 = ((sx8 - (320 + wz.ox) * 256) * 100) / wz.sx + 320 * 256;
+            int x0 = lx8 >> 8, fx = lx8 & 255;
+            for (c = 0; c < 3; c++)
+            {
+               static const int bg[3] = { 3, 10, 6 };
+               int v00 = bg[c], v10 = bg[c], v01 = bg[c], v11 = bg[c], top, bot;
+               if (lx8 >= -256 && x0 < 640)
+               {
+                  if (y0 >= 0 && x0 >= 0)                       v00 = wz_rgb[(y0 * 640 + x0) * 3 + c];
+                  if (y0 >= 0 && x0 + 1 < 640)                  v10 = wz_rgb[(y0 * 640 + x0 + 1) * 3 + c];
+                  if (y0 + 1 < WZ_ROWS && x0 >= 0)              v01 = wz_rgb[((y0 + 1) * 640 + x0) * 3 + c];
+                  if (y0 + 1 < WZ_ROWS && x0 + 1 < 640)         v11 = wz_rgb[((y0 + 1) * 640 + x0 + 1) * 3 + c];
+               }
+               top = v00 + (((v10 - v00) * fx) >> 8);
+               bot = v01 + (((v11 - v01) * fx) >> 8);
+               px[k][c] = top + (((bot - top) * fy) >> 8);
+            }
+         }
+         row[X / 2] = wz_yuv(px[0][0], px[0][1], px[0][2], px[1][0], px[1][1], px[1][2]);
+      }
+   }
+}
+
+/* one animation step; redraws only when something visible changed. ms = time since start. */
+static void wz_step(u32 ms, bool loading)
+{
+   char line2[64];
+   int n1    = (int)(ms * 60 / 1000) + 2, len1 = (int)strlen(wz_line1), key, cx;
+   bool cur  = ((ms * 24 / 10000) % 2) == 0;          /* the launcher's 2.4 Hz blink */
+   int p     = 0;
+   if (n1 > len1)
+      n1 = len1;
+   line2[0] = '\0';
+   if (loading && ms > 300)
+   {
+      /* bytes of the content file read so far; without that (no size), a slow time-based creep */
+      if (wz_content_size)
+      {
+         u64 rd = wz_read_bytes;
+         p = (int)(rd * 950 / wz_content_size);
+         if (p > 950)
+            p = 950;
+      }
+      {
+         int pt = (int)(ms / 40);                       /* never frozen: at least 2.5 %/s, up to 60 % */
+         if (pt > 600)
+            pt = 600;
+         if (wz_content_size == 0 && pt > p)
+            p = pt;
+         else if (p < pt / 4)
+            p = pt / 4;
+      }
+      if (p < wz_p_shown)
+         p = wz_p_shown;
+      wz_p_shown = p;
+      {
+         int fill = p * WZ_BAR / 1000;
+         snprintf(line2, sizeof(line2), "  [%.*s%*s] %3d%%", fill, "############################",
+               WZ_BAR - fill, "", p / 10);
+      }
+   }
+   cx  = WZ_X + (n1 < len1 ? n1 : len1 + 1) * WZ_FONT_ADV;
+   key = (n1 << 16) ^ (cur ? 0x8000 : 0) ^ (wz_p_shown * 7) ^ (line2[0] ? 0x4000 : 0);
+   if (key == wz_last_key)
+      return;
+   wz_last_key = key;
+   memset(wz_txt, 0, WZ_ROWS * 640);
+   {
+      char l1[96];
+      snprintf(l1, sizeof(l1), "%.*s", n1, wz_line1);
+      wz_text(l1, WZ_X, WZ_LINE1);
+   }
+   if (line2[0])
+      wz_text(line2, WZ_X, WZ_LINE2);
+   wz_present(cx, cur);
+}
+
+static void *wz_anim(void *arg)
+{
+   (void)arg;
+   while (wz_run)
+   {
+      wz_step((u32)ticks_to_millisecs(gettime() - wz_t0), true);
+      usleep(30 * 1000);
+   }
+   return NULL;
+}
+
+/* a framebuffer of our own in the launcher's video mode (no CRT resync), filled with the background colour */
+static bool wz_screen_open(const char *line1, bool typed)
+{
+   size_t fbsize;
+   wz_mode = VIDEO_GetPreferredMode(NULL);
+   if (!wz_mode)
+      return false;
+   fbsize     = (size_t)wz_mode->fbWidth * wz_mode->xfbHeight * VI_DISPLAY_PIX_SZ;
+   wz_xfb_mem = memalign(32, fbsize);
+   wz_txt     = (u8*)malloc(WZ_ROWS * 640);
+   wz_glw     = (u8*)malloc(WZ_ROWS * 640);
+   wz_tmp     = (u8*)malloc(WZ_ROWS * 640);
+   wz_rgb     = (u8*)malloc(WZ_ROWS * 640 * 3);
+   if (!wz_xfb_mem || !wz_txt || !wz_glw || !wz_tmp || !wz_rgb)
+      return false;
+   DCInvalidateRange(wz_xfb_mem, fbsize);
+   wz_xfb = (u32*)MEM_K0_TO_K1(wz_xfb_mem);
+   snprintf(wz_line1, sizeof(wz_line1), "%s", line1);
+   wz_last_key = -1;
+   wz_p_shown  = 0;
+   wz_fill_bg();
+   wz_t0 = gettime();
+   wz_step(typed ? 0 : 5000, false);              /* 5 s in: fully typed, cursor on */
+   VIDEO_Configure(wz_mode);
+   VIDEO_SetNextFramebuffer(wz_xfb);
+   VIDEO_SetBlack(false);
+   VIDEO_Flush();
+   VIDEO_WaitVSync();
+   if (wz_mode->viTVMode & VI_NON_INTERLACE)
+      VIDEO_WaitVSync();
+   return true;
+}
+
+static void wz_screen_free(void)
+{
+   free(wz_txt); free(wz_glw); free(wz_tmp); free(wz_rgb);
+   wz_txt = wz_glw = wz_tmp = wz_rgb = NULL;
+   free(wz_xfb_mem);
+   wz_xfb_mem = NULL;
+   wz_xfb     = NULL;
+}
+
+/* frontend init, before anything else: "> LOADING <TITLE>" */
+static void wiizard_loading_start(void)
+{
+   char line1[96];
+   size_t max = (640 - WZ_X - 20) / WZ_FONT_ADV - 10;  /* "> LOADING " + title within the right margin */
+   if (strlen(wz.title) > max)
+      snprintf(line1, sizeof(line1), "> LOADING %.*s...", (int)max - 3, wz.title);
+   else
+      snprintf(line1, sizeof(line1), "> LOADING %s", wz.title);
+   VIDEO_Init();
+   if (!wz_screen_open(line1, true))
+   {
+      wz_screen_free();
+      return;
+   }
+   wz_stack = (u8*)memalign(32, 16 * 1024);
+   wz_run   = 1;
+   if (!wz_stack || LWP_CreateThread(&wz_thread, wz_anim, NULL, wz_stack, 16 * 1024, 80) < 0)
+   {
+      wz_run    = 0;
+      wz_thread = LWP_THREAD_NULL;
+   }
+}
+
+/* video driver init (gx_init) and frontend deinit: the game's own picture takes over */
+static void wiizard_loading_stop(void)
+{
+   if (wz_thread != LWP_THREAD_NULL)
+   {
+      wz_run = 0;
+      LWP_JoinThread(wz_thread, NULL);
+      wz_thread = LWP_THREAD_NULL;
+      RARCH_LOG("[WIIZARD] loading screen up %u ms, content read %u of %u bytes.\n",
+            (unsigned)ticks_to_millisecs(gettime() - wz_t0), (unsigned)wz_read_bytes, (unsigned)wz_content_size);
+   }
+   wiizard_untrack_content();
+   if (wz_xfb_mem)
+   {
+      VIDEO_SetBlack(true);
+      VIDEO_Flush();
+      VIDEO_WaitVSync();
+      wz_screen_free();
+   }
+   free(wz_stack);
+   wz_stack = NULL;
+}
+
+/* gx_init: content is loaded (the video driver starts only after it), the game picture takes over */
+void wiizard_video_init(void)
+{
+   if (wz.active)
+      wz_game_ran = true;
+   wiizard_loading_stop();
+}
+
+/* frontend shutdown (every quit: menu, L+R+Z+START, network QUIT, autotest): straight back to the launcher.
+ * Returns only when not started by WIIZARD or the launcher can't be started (then the usual exit()). */
+static void wiizard_return_to_launcher(void)
+{
+   char args[64];
+   size_t len;
+   struct stat st;
+   if (!wz.active)
+      return;
+   wiizard_loading_stop();
+   if (stat(WZ_LAUNCHER, &st) != 0)
+      return;
+   wz_screen_open("> RETURNING TO WIIZARD", false);
+   len = (size_t)snprintf(args, sizeof(args), "--relaunch=game") + 1;
+   if (wz_game_ran)         /* a deliberate quit after the game ran: the launcher must not take it for a failed start */
+      len += (size_t)snprintf(args + len, sizeof(args) - len, "--game-ran") + 1;
+   if (wz.autobooted)
+      len += (size_t)snprintf(args + len, sizeof(args) - len, "--autobooted") + 1;
+   args[len++] = '\0';
+   wiizard_exec_wii(WZ_LAUNCHER, args, len);   /* no return on success */
+   wz_screen_free();
+}
