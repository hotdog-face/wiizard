 static void memcpybitmask8( uint8_t *dest, const uint32_t *source, const uint8_t *bitmask, int count ){
+#ifdef MSB_FIRST
+	/* big-endian: the 32-bit reads below take pixel 0 from the low end of the word (little-endian only) */
+	const uint8_t *s = (const uint8_t *)source;
+	do{
+		uint32_t data = *bitmask++;
+		if( data&0x80 ) dest[0] = s[0];
+		if( data&0x40 ) dest[1] = s[1];
+		if( data&0x20 ) dest[2] = s[2];
+		if( data&0x10 ) dest[3] = s[3];
+		if( data&0x08 ) dest[4] = s[4];
+		if( data&0x04 ) dest[5] = s[5];
+		if( data&0x02 ) dest[6] = s[6];
+		if( data&0x01 ) dest[7] = s[7];
+		s+=8;
+		dest+=8;
+		count--;
+	}while (count);
+	return;
+#endif
 	do{
 		uint32_t data = *bitmask++;
 		uint32_t src = *source++;
